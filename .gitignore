#######################################################
# KEEP ITEMS IN ALPHABETICAL ORDER WITHIN THEIR GROUP #
#######################################################

# Temporary and binary files
*~
*.log
*.pot
*.py[cod]
*.orig
*.so
*.swp
.DS_Store
.cache/*
__pycache__/*
wip/*
**/.ipynb_checkpoints/*
**/.thumbs/*

# Project files
.dmypy.json
.idea
.project
.pydevproject
.ropeproject
.settings
.vscode
tags

# Package files
*.egg
*.eggs/
*.egg-info
.installed.cfg

# Unittest and coverage
htmlcov/*
.coverage
.coverage.*
.tox
junit*.xml
coverage.xml
.pytest_cache/

# Build and docs folder/files
_build/*
_coverage/*
build/*
dist/*
sdist/*
docs/_api/*
docs/_rst/*
docs/_build/*
cover/*
MANIFEST

# Per-project virtualenvs
.venv*/
.conda*/
venv*/*

# Jupyter files
*checkpoint.ipynb

# Generated figures
# Plots are derived artifacts — regenerate them from the tracked .csv rather
# than storing them. The run plots under output/ are handled by output/.gitignore,
# which is deny-all and simply stops re-including *.png; this rule covers
# everywhere else. docs/ images are hand-written documentation, so keep those.
# Adding a genuinely new figure elsewhere needs `git add -f`.
*.png
!docs/*.png

# Real-robot deployment binaries (handover_sim2real/sim2real/)
# The sim2real SOURCE is tracked — policy_runner.py, camera.py, the calibration
# scripts and their small .npy/.json. These are the payloads that came with it:
# 454 MB of .ckpt, 630 MB of RealSense .bag, 15 MB of rendered .mp4. GitHub
# hard-rejects anything over 100 MB, and git keeps blobs forever, so a later
# delete would not shrink the history.
#
# Deliberately NOT ignored: checkpoint/*/config.yaml and normalization.npz.
# Those are ~1 KB and are the ONLY record of how to denormalize a checkpoint's
# output — same reasoning as the run npz under output/.gitignore.
*.ckpt
*.bag
*.mp4
handover_sim2real/sim2real/checkpoint/**/*.pt
output_home_shards/
