@@ -529,9 +529,28 @@ class Planner(object):
                 ik_goal_num = len(goal_set)
 
                 if filter_collision:
-                    collision_free = (
-                        collide <= self.cfg.allow_collision_point
-                    ).nonzero()  # == 0
+                    keep_mask = collide <= self.cfg.allow_collision_point  # == 0
+
+                    # Human-hand grasp filter (paper: filter out grasps where the
+                    # robot gripper collides with the human hand). handover-sim2real
+                    # registers a callback on the env; a no-op when unset so the
+                    # stock OMG behavior is unchanged. Receives the IK'd goal-set
+                    # joint configs, returns a boolean "hand-free" mask.
+                    hand_fn = getattr(env, "external_grasp_filter", None)
+                    if hand_fn is not None:
+                        # Check the FINAL grasp (reach_goal_set[:, -1]), not the
+                        # standoff configs in goal_set (== reach_goal_set[:, 0]),
+                        # which sit 8 cm back and never collide.
+                        rg = np.asarray(reach_goal_set)
+                        final_grasps = rg[:, -1] if rg.ndim == 3 else rg
+                        try:
+                            hand_free = np.asarray(hand_fn(final_grasps), dtype=bool)
+                            if hand_free.shape == keep_mask.shape:
+                                keep_mask = keep_mask & hand_free
+                        except Exception as e:
+                            print("external_grasp_filter skipped:", e)
+
+                    collision_free = keep_mask.nonzero()  # == 0
 
                     new_goal_set = []
                     ik_goal_num = len(goal_set)
