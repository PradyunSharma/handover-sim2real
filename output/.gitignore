*

!fetch_cvpr2023_models.sh
!fetch_grasp_trigger_PRE_2.sh

# grasp pin tables (per-split OMG grasp selections — small JSON, useful to version)
!grasp_pin_table_train.json
!grasp_pin_table_val.json

# Track lightweight per-run metadata under rl_runs/ (training logs, plots, and
# configs) so runs can be committed/pushed for record-keeping. The parent dirs
# must be re-included first, then the specific files. The large checkpoints/
# (100s of MB of .pt weights) stay ignored — do NOT commit those to git.
!rl_runs/
!rl_runs/*/
!rl_runs/*/*.csv
!rl_runs/*/*.png
!rl_runs/*/*.yaml
!rl_runs/*/*.npz
rl_runs/*/checkpoints/

# Same policy for dagger_runs/ — track the lightweight per-run metadata (log,
# config, state, grasp registry, curves) but NOT the large per-iter checkpoints
# and demo data (best/ last/ iters/ data/ — ~1 GB/run). Only files DIRECTLY in
# the run dir are re-included; the heavy subdirs stay ignored (one level deeper).
!dagger_runs/
!dagger_runs/*/
!dagger_runs/*/*.csv
!dagger_runs/*/*.json
!dagger_runs/*/*.yaml
!dagger_runs/*/*.png
!dagger_runs/*/*.npz
